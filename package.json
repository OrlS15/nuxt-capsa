{
  "name": "nuxt-capsa",
  "version": "1.0.0",
  "description": "The missing wiring for Nuxt",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./db": {
      "types": "./dist/runtime/db/index.d.ts",
      "import": "./dist/runtime/db/index.js"
    },
    "./auth": {
      "types": "./dist/runtime/auth/index.d.ts",
      "import": "./dist/runtime/auth/index.js"
    },
    "./drive": {
      "types": "./dist/runtime/drive/index.d.ts",
      "import": "./dist/runtime/drive/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "docs": "nuxt prepare docs/example && nuxt dev docs",
    "docs:build": "nuxt prepare docs/example && nuxt generate docs",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "npm:@nuxt/kit-nightly@5.0.0-2610132251-aadc393",
    "defu": "^6.1.7",
    "scule": "^1.3.0",
    "verkit": "^0.5.0"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@electric-sql/pglite": "^0.5.15",
    "@nuxt/devtools": "^4.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "npm:@nuxt/schema-nightly@5.0.0-2610132251-aadc393",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "latest",
    "better-auth": "^1.7.18",
    "changelogen": "^0.6.2",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "eslint": "^10.14.0",
    "files-sdk": "^3.1.2",
    "mysql2": "^3.24.6",
    "nuxt": "npm:nuxt-nightly@5.0.0-2610132251-aadc393",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "better-auth": "^1.7.18",
    "drizzle-kit": "~1.0.0-rc.5",
    "drizzle-orm": "~1.0.0-rc.5",
    "files-sdk": "^3.1.2",
    "nuxt": "^5.0.0-0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "files-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  }
}
